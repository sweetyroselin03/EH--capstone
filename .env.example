# AEHA – Autonomous Ethical Hacking Assistant
# Environment Variables Configuration

# Neon Serverless PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth v5
AUTH_SECRET="aeha-super-secret-random-key-at-least-32-chars-long"
AUTH_URL="http://localhost:3000"

# Initial Admin Credentials (Seeded on startup / seed script)
ADMIN_EMAIL="admin@aeha.local"
ADMIN_PASSWORD="AdminSecurePassword123!"

# Initial Analyst Credentials
ANALYST_EMAIL="analyst@aeha.local"
ANALYST_PASSWORD="AnalystSecurePassword123!"

# AI Provider Configuration
# Options: google | openai | anthropic | mock
AI_PROVIDER="google"
AI_MODEL="gemini-1.5-flash"
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Vercel Cron Secret (protects /api/cron/tick)
CRON_SECRET="aeha-cron-secret-token-key-2026"

# Scanner Worker Authentication (for /worker)
WORKER_TOKEN="aeha-worker-secret-token-9988"
WORKER_HMAC_SECRET="aeha-worker-hmac-sha256-signing-secret"

# Optional Email Alerts via Resend
RESEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@aeha.local"
ALERT_TO_EMAIL="soc-team@aeha.local"

# Default Scan Mode: demo | passive | worker
DEFAULT_MODE="demo"
