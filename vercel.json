{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/app/api/jobs/[id]/advance/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/tick/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/assessments/[id]/reassess/route.ts": {
      "maxDuration": 30
    }
  }
}
